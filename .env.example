# ---- Main server (drix-server) ----
HTTP_ADDR=:8080
DATABASE_URL=postgres://drix:drix@localhost:5432/drix?sslmode=disable
REDIS_URL=redis://localhost:6379/0
# Address agents use to reach the server (shown in the admin "Add worker" dialog).
PUBLIC_URL=http://localhost:8080
# First admin account, created only when no admin exists yet.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
# Set to true when serving over HTTPS.
COOKIE_SECURE=false
# Encrypts stored secrets (alert channel settings, SMTP password). Use a long
# random value and never change it afterwards. start.sh generates one.
# SECRET_KEY=
# Public addresses of the two sites, used for links in emails.
# STATUS_URL=https://status.example.com
# ADMIN_URL=https://admin.example.com
# Fallback mail server until email is set up in Admin -> Settings -> Email.
# start.sh defaults this to the local Mailpit inbox.
# SMTP_URL=smtps://user:password@smtp.example.com?from=Status%20<status@example.com>
# Optional: unique per instance (defaults to hostname + random suffix).
# SERVER_ID=srv-a

# ---- Agent (drix-agent) ----
# start.sh runs this many auto-registered local test workers (test-worker-1..N).
TEST_WORKERS=5
# It also launches one local worker per real token (comma-separated).
# DRIX_AGENT_TOKENS=drx_aaa,drx_bbb    # from Admin -> Workers -> Add worker
# DRIX_SERVER_URL=http://localhost:8080
# DRIX_MAX_CONCURRENCY=512

# ---- Admin web (dev) ----
# VITE_STATUS_URL=http://localhost:3000
