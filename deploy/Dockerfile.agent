# Drix check agent (worker). Build context: repository root.
# ICMP: Docker enables unprivileged ping (net.ipv4.ping_group_range) by
# default; the agent falls back to it automatically. Add --cap-add NET_RAW if
# your runtime disables it.
FROM golang:1.26-alpine AS build
WORKDIR /src
ARG VERSION=dev
ENV CGO_ENABLED=0 GOWORK=off
COPY shared ./shared
COPY agent/go.mod agent/go.sum ./agent/
RUN cd agent && go mod download
COPY agent ./agent
RUN cd agent && go build -trimpath -ldflags="-s -w -X main.version=${VERSION}" -o /out/drix-agent ./cmd/drix-agent

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/drix-agent /drix-agent
ENTRYPOINT ["/drix-agent"]
