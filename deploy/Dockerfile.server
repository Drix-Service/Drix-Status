# Drix main server (API + agent gateway). Build context: repository root.
FROM golang:1.26-alpine AS build
WORKDIR /src
ARG VERSION=dev
ENV CGO_ENABLED=0 GOWORK=off
COPY shared ./shared
COPY server/go.mod server/go.sum ./server/
RUN cd server && go mod download
COPY server ./server
RUN cd server && go build -trimpath -ldflags="-s -w -X main.version=${VERSION}" -o /out/drix-server ./cmd/drix-server

# Alpine (not distroless) so the server can run pg_dump for database backups.
FROM alpine:3.22
RUN apk add --no-cache postgresql17-client ca-certificates tzdata \
 && adduser -D -H -u 10001 drix \
 && mkdir -p /backups && chown drix:drix /backups
COPY --from=build /out/drix-server /drix-server
USER drix
ENV BACKUP_DIR=/backups
EXPOSE 8080
ENTRYPOINT ["/drix-server"]
