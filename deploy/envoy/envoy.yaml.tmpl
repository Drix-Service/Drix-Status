# Envoy front proxy for Drix Status. Rendered by install.sh:
#   __STATUS_DOMAIN__ / __ADMIN_DOMAIN__ are replaced with your domains.
#
#   :8080 (published as 80)  -> ACME challenges to certbot, everything else to HTTPS
#   :8443 (published as 443) -> status domain: /api -> server, rest -> status site
#                               admin domain:  /api -> server, rest -> admin site
# The certificate is loaded through SDS from /etc/envoy/tls and reloaded
# automatically when certbot renews it.

node: { id: drix-front, cluster: drix-front }

static_resources:
  listeners:
    - name: http
      address: { socket_address: { address: 0.0.0.0, port_value: 8080 } }
      filter_chains:
        - filters:
            - name: envoy.filters.network.http_connection_manager
              typed_config:
                "@type": type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
                stat_prefix: http
                route_config:
                  virtual_hosts:
                    - name: redirect
                      domains: ["*"]
                      routes:
                        - match: { prefix: "/.well-known/acme-challenge/" }
                          route: { cluster: certbot, timeout: 30s }
                        - match: { prefix: "/" }
                          redirect: { https_redirect: true__PORT_REDIRECT__ }
                http_filters:
                  - name: envoy.filters.http.router
                    typed_config: { "@type": type.googleapis.com/envoy.extensions.filters.http.router.v3.Router }

    - name: https
      address: { socket_address: { address: 0.0.0.0, port_value: 8443 } }
      filter_chains:
        - transport_socket:
            name: envoy.transport_sockets.tls
            typed_config:
              "@type": type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.DownstreamTlsContext
              common_tls_context:
                alpn_protocols: ["h2", "http/1.1"]
                tls_params: { tls_minimum_protocol_version: TLSv1_2 }
                tls_certificate_sds_secret_configs:
                  - name: drix_cert
                    sds_config:
                      path_config_source:
                        path: /etc/envoy/tls/sds.yaml
                        watched_directory: { path: /etc/envoy/tls }
          filters:
            - name: envoy.filters.network.http_connection_manager
              typed_config:
                "@type": type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
                stat_prefix: https
                codec_type: AUTO
                use_remote_address: true
                # Agents use WebSockets; live updates use long-lived SSE streams.
                upgrade_configs: [{ upgrade_type: websocket }]
                stream_idle_timeout: 300s
                common_http_protocol_options: { idle_timeout: 3600s }
                route_config:
                  response_headers_to_add:
                    - header: { key: Strict-Transport-Security, value: "max-age=31536000" }
                  virtual_hosts:
                    - name: status
                      domains: ["__STATUS_DOMAIN__", "__STATUS_DOMAIN__:*"]
                      routes:
                        # Let's Encrypt may arrive over HTTPS (e.g. Cloudflare "Always Use HTTPS").
                        - match: { prefix: "/.well-known/acme-challenge/" }
                          route: { cluster: certbot, timeout: 30s }
                        - match: { prefix: "/api/" }
                          route: { cluster: server, timeout: 0s }
                        - match: { prefix: "/healthz" }
                          route: { cluster: server }
                        - match: { prefix: "/" }
                          route: { cluster: status_web }
                    - name: admin
                      domains: ["__ADMIN_DOMAIN__", "__ADMIN_DOMAIN__:*"]
                      routes:
                        # Let's Encrypt may arrive over HTTPS (e.g. Cloudflare "Always Use HTTPS").
                        - match: { prefix: "/.well-known/acme-challenge/" }
                          route: { cluster: certbot, timeout: 30s }
                        - match: { prefix: "/api/" }
                          route: { cluster: server, timeout: 0s }
                        - match: { prefix: "/" }
                          route: { cluster: admin_web }
                    - name: unknown
                      domains: ["*"]
                      routes:
                        - match: { prefix: "/" }
                          direct_response: { status: 404, body: { inline_string: "Unknown host\n" } }
                http_filters:
                  - name: envoy.filters.http.router
                    typed_config: { "@type": type.googleapis.com/envoy.extensions.filters.http.router.v3.Router }

  clusters:
    - name: server
      type: STRICT_DNS
      connect_timeout: 5s
      load_assignment:
        cluster_name: server
        endpoints: [{ lb_endpoints: [{ endpoint: { address: { socket_address: { address: server, port_value: 8080 } } } }] }]
    - name: status_web
      type: STRICT_DNS
      connect_timeout: 5s
      load_assignment:
        cluster_name: status_web
        endpoints: [{ lb_endpoints: [{ endpoint: { address: { socket_address: { address: status-web, port_value: 80 } } } }] }]
    - name: admin_web
      type: STRICT_DNS
      connect_timeout: 5s
      load_assignment:
        cluster_name: admin_web
        endpoints: [{ lb_endpoints: [{ endpoint: { address: { socket_address: { address: admin-web, port_value: 80 } } } }] }]
    - name: certbot
      type: STRICT_DNS
      connect_timeout: 2s
      load_assignment:
        cluster_name: certbot
        endpoints: [{ lb_endpoints: [{ endpoint: { address: { socket_address: { address: certbot, port_value: 8888 } } } }] }]
