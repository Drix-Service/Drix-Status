{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["vite/client"],
    "paths": {
      "@drix/ui/*": ["./packages/ui/src/*"],
      "@status/*": ["./apps/status/src/*"],
      "@admin/*": ["./apps/admin/src/*"]
    }
  },
  "include": ["packages/ui/src", "apps/status/src", "apps/admin/src"]
}
